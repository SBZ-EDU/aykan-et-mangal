      "id": "1a2b3c4d-0008-4000-8000-000000000008",
      "name": "8. انتظار پردازش اینستاگرام (30 ثانیه)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
