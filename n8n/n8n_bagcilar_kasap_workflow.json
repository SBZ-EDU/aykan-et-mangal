        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $node[\"7. ساخت کانتینر ریلز در اینستاگرام (Create Reels Container)\"].json.id }}"
            },
            {
              "name": "access_token",
              "value": "YOUR_META_ACCESS_TOKEN"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0009-4000-8000-000000000009",
      "name": "9. انتشار نهایی ریلز در اینستاگرام (Publish Reel)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
