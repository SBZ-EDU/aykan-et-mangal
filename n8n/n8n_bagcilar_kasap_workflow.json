{
  "name": "Aykan Et & Mangal (@aykanetmangal) - Auto Reels Generator (Debugged v2)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "تولیدکننده خودکار ریلز Aykan Et & Mangal (Veo 3.1 + Instagram)",
        "formDescription": "محصول یا پیشنهاد امروز شعب باجیلار (Göztepe) و اسنلر (Kemer) را وارد کنید تا ویدیوی ۹:۱۶ و کپشن ترکی ساخته و منتشر شود.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "محصول امروز (مثلاً: Dana Antrikot 1100 TL، پکیج منقل، کباب تورتیلا، Dana Kemikli 650 TL)",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "قیمت یا پیشنهاد ویژه به لیر (اختیاری)",
              "fieldType": "text",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "1. ورودی ایده روزانه (Form Trigger)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GOOGLE_AI_STUDIO_API_KEY"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  system_instruction: {\n    parts: [{\n      text: \"You are a social media marketing expert for 'Aykan Et & Mangal | Kasap Izgara' (@aykanetmangal), an Et, Balık, Tavuk, Kuzu Tanzim Satış Mağazası with 2 branches in Istanbul: 1) Göztepe Mah. Maslak Cad. No: 95A-95C Bağcılar (near Göztepe Metro), and 2) Kemer Mah. 926. Sokak No: 2/C Esenler. WhatsApp Order: 0537 732 52 69. Open daily until 22:30. Always respond in valid JSON format with two keys: 'veo_prompt' (detailed English prompt for Google Veo 3.1 vertical 9:16 video, photorealistic, Turkish butcher/grill aesthetic, native ASMR sizzling/slicing audio, no text watermark) and 'instagram_caption_tr' (engaging Turkish caption for Bağcılar & Esenler residents mentioning Aykan Et & Mangal, both branch addresses, WhatsApp 0537 732 52 69, plus local hashtags #BağcılarKasap #GöztepeKasap #EsenlerKasap #AykanEtMangal #TanzimSatış).\"\n    }]\n  },\n  contents: [{\n    parts: [{\n      text: \"Product/Topic: \" + ($json[\"محصول امروز (مثلاً: Dana Antrikot 1100 TL، پکیج منقل، کباب تورتیلا، Dana Kemikli 650 TL)\"] || \"\") + \" | Special Price/Offer: \" + ($json[\"قیمت یا پیشنهاد ویژه به لیر (اختیاری)\"] || \"\")\n    }]\n  }],\n  generationConfig: {\n    responseMimeType: \"application/json\"\n  }\n}) }}",
        "options": {}
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "2. ساخت پرامپت Veo و کپشن ترکی (Gemini AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json?.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nconst cleaned = rawText.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\nconst parsed = JSON.parse(cleaned);\nreturn [\n  {\n    json: {\n      veo_prompt: parsed.veo_prompt || 'Vertical 9:16 close-up shot in a Turkish butcher shop slicing fresh marbled beef, native ASMR audio.',\n      instagram_caption_tr: parsed.instagram_caption_tr || 'Aykan Et & Mangal - Göztepe Bağcılar & Kemer Esenler | WhatsApp: 0537 732 52 69'\n    }\n  }\n];"
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "3. جداسازی ایمن پرامپت و کپشن (Safe Parse JSON)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/veo-3.1-generate-preview:predictLongRunning",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GOOGLE_AI_STUDIO_API_KEY"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  instances: [{ prompt: $json.veo_prompt }],\n  parameters: { aspectRatio: \"9:16\", resolution: \"720p\" }\n}) }}",
        "options": {}
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "4. ارسال به Google Veo 3.1 (تولید ویدیو 9:16)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "amount": 45,
        "unit": "seconds"
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "5. انتظار برای رندر ویدیو (45 ثانیه)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://generativelanguage.googleapis.com/v1beta/{{ $node[\"4. ارسال به Google Veo 3.1 (تولید ویدیو 9:16)\"].json.name }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GOOGLE_AI_STUDIO_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "6. بررسی وضعیت ساخت ویدیو (Poll Veo Status)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-done-check",
              "leftValue": "={{ Boolean($json.done) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0006-4000-8000-00000000006b",
      "name": "6b. آیا رندر ویدیو کامل شده؟ (Check Done)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $json.response.generateVideoResponse.generatedSamples[0].video.uri }}"
            },
            {
              "name": "caption",
              "value": "={{ $node[\"3. جداسازی ایمن پرامپت و کپشن (Safe Parse JSON)\"].json.instagram_caption_tr }}"
            },
            {
              "name": "access_token",
              "value": "YOUR_META_ACCESS_TOKEN"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0007-4000-8000-000000000007",
      "name": "7. ساخت کانتینر ریلز در اینستاگرام (Create Reels Container)",
      "type": "n8n-nodes-base.httpRequest",
